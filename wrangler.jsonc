{
  // Ecosystem HR Suite · servidor de conexión de una empresa (Cloudflare, plan gratuito)
  "name": "ecosystem-hr-suit",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/m/manifest.webmanifest"] },
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "Relay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.pem"], "fallthrough": true }],
  "observability": { "enabled": false }
}
